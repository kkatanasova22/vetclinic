@model Treatment
@{
    ViewData["Title"] = "Edit treatment";
}
<section class="page-heading"><div><h1>Edit treatment</h1><p>Update the procedure and price on this visit.</p></div></section>
<form asp-action="Edit" asp-route-id="@Model.TreatmentId" method="post" class="form-card">
    <input asp-for="TreatmentId" type="hidden" />
    <div asp-validation-summary="ModelOnly"></div>
    <div class="form-grid">
        <div class="form-group full"><label asp-for="AppointmentId">Appointment <span aria-hidden="true">*</span></label><select asp-for="AppointmentId" asp-items="ViewBag.AppointmentId" class="form-control"><option value="">Choose an appointment</option></select><span asp-validation-for="AppointmentId"></span></div>
        <div class="form-group"><label asp-for="TreatmentName">Procedure or treatment <span aria-hidden="true">*</span></label><input asp-for="TreatmentName" class="form-control" /><span asp-validation-for="TreatmentName"></span></div>
        <div class="form-group"><label asp-for="Price">Price (лв.) <span aria-hidden="true">*</span></label><input asp-for="Price" class="form-control" type="number" min="0" step="0.01" /><span asp-validation-for="Price"></span></div>
    </div>
    <div class="form-actions"><a class="btn-secondary" asp-action="Index">Cancel</a><button type="submit" class="btn-primary">Save changes</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
