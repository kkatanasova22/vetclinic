@model IReadOnlyList<Veterinarian>
@{
    ViewData["Title"] = "Veterinarians";
}
<section class="page-heading">
    <div><h1>Veterinarians</h1><p>Meet the people caring for your patients.</p><div class="heading-meta"><span><strong>@ViewData["VeterinarianCount"]</strong> care team members</span></div></div>
    <div class="heading-actions"><a class="btn-primary" asp-action="Create"><span aria-hidden="true">＋</span> Add veterinarian</a></div>
</section>
<section class="panel">
    <div class="panel-header"><div><h2>Medical team</h2><p>Manage veterinarian details and specialties.</p></div><span class="result-count">@Model.Count veterinarians</span></div>
    <div class="panel-body">
        <div class="list-toolbar"><form asp-action="Index" method="get" class="search-filter"><label class="search-box"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg><input type="search" name="search" value="@ViewData["Search"]" placeholder="Search by name or specialty..." aria-label="Search veterinarians" /></label><select class="filter-select" name="sort"><option value="">By name</option><option value="specialty" selected="@(ViewData["Sort"]?.ToString() == "specialty")">By specialty</option></select><button class="btn-secondary btn-small" type="submit">Search</button></form></div>
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th>Veterinarian</th><th>Specialty</th><th>Appointments</th><th>Actions</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="empty-state">No veterinarians found. Add a team member to schedule visits.</td></tr>
            }
            else
            {
                @foreach (var veterinarian in Model)
                {
                    <tr><td><span class="owner-avatar">@veterinarian.FirstName[0]@veterinarian.LastName[0]</span><span class="table-person"><span class="table-primary">Dr. @veterinarian.FirstName @veterinarian.LastName</span><span class="table-secondary">Clinic care team</span></span></td><td>@(string.IsNullOrWhiteSpace(veterinarian.Specialty) ? "General practice" : veterinarian.Specialty)</td><td>@veterinarian.Appointments.Count</td><td><div class="table-actions"><a class="action-link" asp-action="Edit" asp-route-id="@veterinarian.VeterinarianId" title="Edit veterinarian" aria-label="Edit Dr. @veterinarian.LastName">✎</a><a class="action-link delete" asp-action="Delete" asp-route-id="@veterinarian.VeterinarianId" title="Delete veterinarian" aria-label="Delete Dr. @veterinarian.LastName">⌫</a></div></td></tr>
                }
            }
            </tbody>
        </table></div>
        <div class="pagination-note"><span>Showing @Model.Count veterinarians</span><span>Veterinarians are managed by the administrator.</span></div>
        @if (ViewData["PageInfo"] is PageInfo pageInfo) { <partial name="_Pagination" model="pageInfo" /> }
    </div>
</section>
