@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="login-shell">
    <section class="login-hero">
        <div class="hero-brand">
            <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8.2 10.2c1.2 0 2-1.3 1.7-2.7-.2-1.4-1.1-2.4-2.3-2.4S5.7 6.2 6 7.6c.3 1.5 1 2.6 2.2 2.6Zm7.6 0c1.2 0 2-1.1 2.2-2.6.3-1.4-.4-2.5-1.6-2.5s-2.1 1-2.3 2.4c-.3 1.4.5 2.7 1.7 2.7ZM4.7 14c1 0 1.7-1 1.6-2.2-.1-1.2-.9-2-1.9-1.9-.9.1-1.5 1.2-1.4 2.4.1 1.1.8 1.8 1.7 1.7Zm14.6 0c.9.1 1.6-.6 1.7-1.7.1-1.2-.5-2.3-1.4-2.4-1-.1-1.8.7-1.9 1.9-.1 1.2.6 2.2 1.6 2.2Zm-7.3 6c2.5 0 5.1-.8 5.1-2.7 0-1.6-1.7-3.5-3.2-4.5-.7-.5-1.3-.7-1.9-.7s-1.2.2-1.9.7c-1.5 1-3.2 2.9-3.2 4.5 0 1.9 2.6 2.7 5.1 2.7Z" /></svg>
            </span>
            <span>VetClinic</span>
        </div>
        <div class="hero-orbit one"></div><div class="hero-orbit two"></div><div class="hero-orbit three"></div>
        <div class="hero-paw" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8.2 10.2c1.2 0 2-1.3 1.7-2.7-.2-1.4-1.1-2.4-2.3-2.4S5.7 6.2 6 7.6c.3 1.5 1 2.6 2.2 2.6Zm7.6 0c1.2 0 2-1.1 2.2-2.6.3-1.4-.4-2.5-1.6-2.5s-2.1 1-2.3 2.4c-.3 1.4.5 2.7 1.7 2.7ZM4.7 14c1 0 1.7-1 1.6-2.2-.1-1.2-.9-2-1.9-1.9-.9.1-1.5 1.2-1.4 2.4.1 1.1.8 1.8 1.7 1.7Zm14.6 0c.9.1 1.6-.6 1.7-1.7.1-1.2-.5-2.3-1.4-2.4-1-.1-1.8.7-1.9 1.9-.1 1.2.6 2.2 1.6 2.2Zm-7.3 6c2.5 0 5.1-.8 5.1-2.7 0-1.6-1.7-3.5-3.2-4.5-.7-.5-1.3-.7-1.9-.7s-1.2.2-1.9.7c-1.5 1-3.2 2.9-3.2 4.5 0 1.9 2.6 2.7 5.1 2.7Z" /></svg>
        </div>
        <h1>More time for paws.<br />Less time on paperwork.</h1>
        <p>Your connected workspace for people, patients, and the care that brings them together.</p>
        <div class="login-hero-foot">Made for veterinary teams · Built for better care</div>
    </section>

    <section class="login-form-panel">
        <h2>Welcome back</h2>
        <p>Sign in to your clinic workspace to continue.</p>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly"></div>
            <div class="form-group">
                <label asp-for="Email">Email address <span aria-hidden="true">*</span></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@yourclinic.com" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password">Password <span aria-hidden="true">*</span></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="login-meta">
                <label class="remember-check"><input asp-for="RememberMe" /> Remember me</label>
                <span>Need help signing in?</span>
            </div>
            <button type="submit" class="btn-primary login-submit"><span aria-hidden="true">→</span> Sign in</button>
            <div class="login-protected"><span aria-hidden="true">♧</span> Your clinic information is safe and protected.</div>
        </form>
        <p class="register-prompt">Don't have an account? <a asp-action="Register">Create a client account</a></p>
        <div class="auth-footer"><span>© 2026 VetClinic</span><span>Privacy · Terms of use</span></div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
