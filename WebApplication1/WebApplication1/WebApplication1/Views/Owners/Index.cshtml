@model IReadOnlyList<Owner>
@{
    ViewData["Title"] = "Owners";
}

<section class="page-heading">
    <div>
        <h1>Owners</h1>
        <p>A connected record for every pet parent in your care.</p>
        <div class="heading-meta"><span><strong>@ViewData["OwnerCount"]</strong> registered owners</span><span><strong>@ViewData["PetCount"]</strong> pets in your care</span></div>
    </div>
    <div class="heading-actions"><a class="btn-primary" asp-action="Create"><span aria-hidden="true">＋</span> Add owner</a></div>
</section>

<section class="panel">
    <div class="panel-header"><div><h2>Owner directory</h2><p>Search by name, email, or phone number.</p></div><span class="result-count">@Model.Count records</span></div>
    <div class="panel-body">
        <div class="list-toolbar">
            <form asp-action="Index" method="get" class="search-filter">
                <label class="search-box">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg>
                    <input type="search" name="search" value="@ViewData["Search"]" placeholder="Search by name, email, or phone..." aria-label="Search owners" />
                </label>
                <select class="filter-select" name="sort" aria-label="Sort owners"><option value="">By name</option><option value="email" selected="@(ViewData["Sort"]?.ToString() == "email")">By email</option></select>
                <button class="btn-secondary btn-small" type="submit">Search</button>
            </form>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Owner</th><th>Email</th><th>Phone</th><th>Pets</th><th>Actions</th></tr></thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="empty-state">No owners match this search. Add an owner to create a client record.</td></tr>
                }
                else
                {
                    @foreach (var owner in Model)
                    {
                        <tr>
                            <td><span class="owner-avatar">@owner.FirstName[0]@owner.LastName[0]</span><span class="table-person"><span class="table-primary">@owner.FirstName @owner.LastName</span><span class="table-secondary">Owner #@owner.OwnerId</span></span></td>
                            <td>@owner.Email</td><td>@owner.Phone</td><td>@owner.Pets.Count</td>
                            <td><div class="table-actions"><a class="action-link" asp-action="Edit" asp-route-id="@owner.OwnerId" title="Edit owner" aria-label="Edit @owner.FirstName @owner.LastName">✎</a><a class="action-link delete" asp-action="Delete" asp-route-id="@owner.OwnerId" title="Delete owner" aria-label="Delete @owner.FirstName @owner.LastName">⌫</a></div></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="pagination-note"><span>Showing @Model.Count owners</span><span>Contact details are visible only to clinic staff.</span></div>
        @if (ViewData["PageInfo"] is PageInfo pageInfo) { <partial name="_Pagination" model="pageInfo" /> }
    </div>
</section>
