@model Owner
@{
    ViewData["Title"] = "Delete owner";
}
<section class="page-heading"><div><h1>Delete owner</h1><p>Review the client record before removing it.</p></div></section>
<article class="confirm-card">
    <h2>Remove @Model.FirstName @Model.LastName?</h2>
    <p>This action removes the owner record. Owners with linked pets cannot be deleted so their medical history stays connected.</p>
    <dl class="detail-list"><dt>Email</dt><dd>@Model.Email</dd><dt>Phone</dt><dd>@Model.Phone</dd><dt>Linked pets</dt><dd>@Model.Pets.Count</dd></dl>
    <form asp-action="Delete" asp-route-id="@Model.OwnerId" method="post" class="form-actions"><a class="btn-secondary" asp-action="Index">Cancel</a><button type="submit" class="btn-danger">Delete owner</button></form>
</article>
